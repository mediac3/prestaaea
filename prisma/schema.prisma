generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  cedula    String
  phone     String
  address   String?
  notes     String?
  status    String   @default("activo") // activo, inactivo, moroso
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loans     Loan[]
}

model CreditProduct {
  id          String   @id @default(cuid())
  name        String
  baseRate    Float    // monthly interest rate percentage
  maxTerm     Int      // max term in months
  maxAmount   Float?
  requirements String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Loan {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  amount        Float    // original loan amount (COP)
  rate          Float    // monthly interest rate percentage
  term          Int      // term in months
  startDate     DateTime
  paymentDay    Int      // day of month for payment (1-31)
  amortization  String   @default("interes_fijo") // francesa, alemana, interes_fijo
  status        String   @default("activo") // activo, vencido, pagado, cerrado
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id])
  date          DateTime
  type          String   @default("interes") // interes, interes_capital, capital
  interestAmount Float   @default(0)
  capitalAmount  Float   @default(0)
  previousBalance Float
  newBalance    Float
  notes         String?
  createdAt     DateTime @default(now())
}
